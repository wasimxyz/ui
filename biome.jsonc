{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      // Generated by `npm run registry:build` (shadcn) — leave it to that
      // tool's own output formatting rather than letting Biome reformat it.
      "!public/registry/*.json",
      // Managed by Next.js, which rewrites them on every build/dev start —
      // don't fight its formatting.
      "!tsconfig.json",
      "!next-env.d.ts"
    ]
  }
}
